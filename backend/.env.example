# Backblaze B2
B2_KEY_ID=your_key_id_here
B2_APP_KEY=your_app_key_here
B2_BUCKET_NAME=notary-media
B2_REGION=us-east-005

# Google AI API Keys (comma-separated, rotated in order on quota errors)
# Free tier has 0 image generation quota — needs Google AI Pro / billing enabled
GOOGLE_API_KEYS=key1,key2,key3

# GitHub Models — free image generation (gpt-image-1) via GitHub PAT
# Get a PAT at: github.com/settings/tokens (no special scopes needed for Models)
GITHUB_PAT=ghp_your_token_here

# SQLite cache path (optional — defaults to notary_cache.sqlite)
# CACHE_DB_PATH=notary_cache.sqlite
