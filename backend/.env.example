# Backblaze B2
B2_KEY_ID=your_key_id_here
B2_APP_KEY=your_app_key_here
B2_BUCKET_NAME=notary-media
B2_REGION=us-east-005
# Create this bucket with B2 File Lock enabled before uploading any assets.
B2_OBJECT_LOCK_ENABLED=true
B2_OBJECT_LOCK_MODE=COMPLIANCE
B2_MANIFEST_RETENTION_DAYS=365
# Optional friendly URL/CDN for browser media previews. Keep the bucket private
# and serve presigned URLs in a production deployment if this is unset.
# B2_PUBLIC_URL_BASE=https://f000.backblazeb2.com/file/notary-media

# Google AI API Keys (comma-separated, rotated in order on quota errors)
# Free tier has 0 image generation quota — needs Google AI Pro / billing enabled
GOOGLE_API_KEYS=key1,key2,key3

# NVIDIA NIM API Key (secondary fallback provider)
# Get a key at build.nvidia.com
NVIDIA_API_KEY=nvapi-your_key_here
# Keep the NVIDIA stage bounded so the public Space can take over when a NIM
# endpoint is unavailable for this account.
NVIDIA_IMAGE_TIMEOUT_SECONDS=45

# Hugging Face public Space fallback. HF_TOKEN is optional but can improve
# public Space quota; it is sent only by the backend and never stored in B2.
HF_SPACE_ID=black-forest-labs/FLUX.2-klein-4B
HF_SPACE_TIMEOUT_SECONDS=180
HF_TOKEN=

# Optional final fallback. Pollinations uses its own API key and billing;
# do not put an HF token here.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_TIMEOUT_SECONDS=90

# Optional Gemini Vision post-generation policy inspection. It is off by
# default so image generation never silently consumes a separate model quota.
# When disabled or unavailable, Notary reports that state rather than a pass.
POST_GENERATION_VISUAL_AUDIT=false
VISUAL_AUDIT_MODEL=gemini-2.0-flash

# SQLite cache path (optional — defaults to notary_cache.sqlite)
# CACHE_DB_PATH=notary_cache.sqlite

# Prompt cache TTL in hours (optional — defaults to 4).
# Exact-match prompts within this window return the cached result instantly
# instead of re-running the provider cascade. Set to 168 (7 days) for the
# hackathon judging window so demo assets are always instant.
CACHE_MAX_AGE_HOURS=4
